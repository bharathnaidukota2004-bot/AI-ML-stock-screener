# .env.example — Copy this to .env and fill in your real values
# WARNING: Never commit your actual .env file to GitHub!

# ─── Telegram Bot Settings ─────────────────────────────────────────────────────
# Get these from @BotFather on Telegram:
#   1. Send /newbot to @BotFather
#   2. Copy the token it gives you into TELEGRAM_BOT_TOKEN
#   3. Send a message to your bot, then visit:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      to find your CHAT_ID
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=987654321

# ─── Fyers API (optional alternative broker) ───────────────────────────────────
FYERS_CLIENT_ID=your_client_id_here
FYERS_SECRET_KEY=your_secret_key_here

# ─── Angel One SmartAPI (primary broker) ───────────────────────────────────────
# These can also go in config/credentials.json — either works
ANGEL_API_KEY=your_angel_one_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_KEY=your_totp_base32_key_here

# ─── App Mode ──────────────────────────────────────────────────────────────────
USE_SIMULATOR=true   # set to false for live market trading
